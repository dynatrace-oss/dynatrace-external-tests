// `scalar: true` rather than arrayAvg(val): arrayAvg gives every time bucket
// equal weight, so quiet buckets skew the headline away from the true mean.
// `val` is still returned — the tile's trend indicator needs the series.
timeseries { val = avg(external.test.duration), scalar_val = avg(external.test.duration, scalar: true) },
  filter: { (arrayFirst(array($testId)) == "* : All tests" OR in(test.id, iCollectArray(arrayFirst(splitString(array($testId)[], " : "))))) and (arrayFirst(array($location)) == "*" OR in(test.run.location, array($location))) }
| fieldsAdd avg_duration_ms = round(scalar_val, decimals: 1)
| fields timeframe, interval, avg_duration_ms, val
