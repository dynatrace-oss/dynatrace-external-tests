timeseries {
    av = count(external.test.availability),
    dur = count(external.test.duration),
    exec = count(external.test.executions),
    evt = count(external.test.usage.events_ingested),
    step = count(external.test.step.duration)
}, interval: 1d
| fieldsAdd total_data_points = toLong(arraySum(av) + arraySum(dur) + arraySum(exec) + arraySum(evt) + arraySum(step))
| fields total_data_points
