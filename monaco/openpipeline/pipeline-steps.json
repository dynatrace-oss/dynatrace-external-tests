{
  "customId": "pipeline-external-test-steps",
  "displayName": "External Test Steps",
  "processing": {
    "processors": [
      {
        "id": "normalize-step-status",
        "description": "Normalize step status to a standard category. Must be a dql processor: fieldsAdd stores its `value` as a literal string, so the expression was written into the data verbatim instead of being evaluated.",
        "type": "dql",
        "matcher": "event.type == \"external_test_step\"",
        "enabled": true,
        "dql": {
          "script": "fieldsAdd `result.status.category` = if(`test.step.status` == \"passed\", \"SUCCESS\", else: if(`test.step.status` == \"skipped\", \"SKIPPED\", else: \"FAIL\"))"
        }
      },
      {
        "id": "mask-step-urls",
        "description": "Drop the query string from step URLs — that is where credentials end up. Keeps the path, which is what the step tiles need.",
        "type": "dql",
        "matcher": "isNotNull(test.step.url)",
        "enabled": true,
        "dql": {
          "script": "fieldsAdd `test.step.url` = if(contains(`test.step.url`, \"?\"), concat(substring(`test.step.url`, to: indexOf(`test.step.url`, \"?\")), \"?***MASKED***\"), else: `test.step.url`)"
        }
      }
    ]
  },
  "smartscapeNodeExtraction": {
    "processors": [
      {
        "id": "stitch-to-parent-node",
        "description": "Resolve the parent EXT_TEST node id onto each step event. extractNode is false: the node itself is created by the runs pipeline, here we only need the id. idComponents must match that processor exactly, or the ids will not line up.",
        "type": "smartscapeNode",
        "matcher": "event.type == \"external_test_step\"",
        "enabled": true,
        "smartscapeNode": {
          "extractNode": false,
          "nodeType": "EXT_TEST",
          "nodeIdFieldName": "dt.smartscape.ext_test",
          "idComponents": [
            {"idComponent": "field", "referencedFieldName": "test.id"}
          ]
        }
      }
    ]
  },
  "storage": {
    "processors": [
      {
        "id": "store-to-default",
        "description": "Store all step events in the external tests bucket for cost attribution",
        "type": "bucketAssignment",
        "matcher": "true",
        "enabled": true,
        "bucketAssignment": {
          "bucketName": "{{ .bucket_name }}"
        }
      }
    ]
  },
  "metricExtraction": {
    "processors": [
      {
        "id": "extract-step-duration-metric",
        "description": "Extract per-step duration metric",
        "type": "valueMetric",
        "matcher": "event.type == \"external_test_step\"",
        "enabled": true,
        "valueMetric": {
          "metricKey": "external.test.step.duration",
          "field": "test.step.duration_ms",
          "dimensions": [
            {"extractionType": "field", "sourceFieldName": "test.id"},
            {"extractionType": "field", "sourceFieldName": "test.step.name"},
            {"extractionType": "field", "sourceFieldName": "test.step.index"}
          ]
        }
      }
    ]
  }
}
